{
  "name": "@ravi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "account:register": "dotenv -e ../../.env -- tsx scripts/register-whatsapp-account.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@ravi/core": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15"
  }
}
