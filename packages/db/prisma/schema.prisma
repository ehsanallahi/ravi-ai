// Ravi AI — PostgreSQL schema. See docs/DATABASE.md.
// Never run destructive migrations (drops / resets) against shared or production data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum WhatsAppAccountStatus {
  ACTIVE
  DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CONTACT
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  BUTTON
  REACTION
  TEMPLATE
  UNSUPPORTED
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum KnowledgeSourceType {
  MANUAL
  FILE
  URL
}

enum KnowledgeDocumentStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  DEAD
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  timezone           String   @default("UTC")
  aiAutoReplyEnabled Boolean  @default(false)
  /// Explicit opt-in (by an Owner) before any data is sent to a third-party AI provider.
  aiDataConsentAt       DateTime?
  aiDataConsentByUserId String?
  /// Monthly AI spend cap in USD; capped by the platform AI_MONTHLY_BUDGET_USD. Null = platform default.
  aiMonthlyBudgetUsd    Decimal?  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships        Membership[]
  whatsappAccounts   WhatsAppAccount[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  leads              Lead[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  auditLogs          AuditLog[]
  invitations        Invitation[]
  aiUsageEvents      AiUsageEvent[]
  aiSuggestions      AiSuggestion[]
  aiBudgetReservations AiBudgetReservation[]
}

model User {
  id               String    @id @default(cuid())
  /// Stored lower-cased.
  email            String    @unique
  /// Always written by the auth layer; nullable only for backwards compatibility.
  name             String?
  /// DEPRECATED (Phase 2): credentials live in Account.password. Kept to avoid a destructive drop.
  passwordHash     String?
  /// DEPRECATED (Phase 2): superseded by `emailVerified`. Kept to avoid a destructive drop.
  emailVerifiedAt  DateTime?
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships           Membership[]
  assignedConversations Conversation[]      @relation("ConversationAssignee")
  sentMessages          Message[]           @relation("MessageSentBy")
  ownedLeads            Lead[]              @relation("LeadOwner")
  createdDocuments      KnowledgeDocument[] @relation("DocumentCreatedBy")
  auditLogs             AuditLog[]
  sessions              Session[]
  accounts              Account[]
  twoFactors            TwoFactor[]
  invitationsSent       Invitation[]        @relation("InvitationInvitedBy")
  invitationsAccepted   Invitation[]        @relation("InvitationAcceptedBy")
}

// ─── Authentication (Better Auth) ───────────────────────────────────────────
// Field names follow Better Auth's schema for its Prisma adapter. Do not rename.

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash (scrypt) for the "credential" provider. Never plaintext.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  /// Encrypted by Better Auth with BETTER_AUTH_SECRET.
  secret                  String
  /// Encrypted backup codes.
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Invitation {
  id               String         @id @default(cuid())
  organizationId   String
  /// Lower-cased. Only this address can accept the invitation.
  email            String
  role             MembershipRole
  /// SHA-256 of the invitation token. The token itself is never stored.
  tokenHash        String         @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  invitedByUserId  String
  acceptedByUserId String?
  createdAt        DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(AGENT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
}

model WhatsAppAccount {
  id                    String                @id @default(cuid())
  organizationId        String
  /// Cloud API phone number ID; webhooks are routed to a tenant by this value.
  phoneNumberId         String                @unique
  wabaId                String
  displayPhoneNumber    String?
  verifiedName          String?
  /// AES-256-GCM ciphertext ("v1:iv:tag:data"). Plaintext tokens are never stored.
  accessTokenCiphertext String?
  status                WhatsAppAccountStatus @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversations Conversation[]

  @@index([organizationId])
}

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  /// WhatsApp ID (normally the phone number in international format, without '+').
  waId           String
  profileName    String?
  displayName    String?
  /// When set, no automated (AI) messages may be sent to this contact.
  optedOutAt     DateTime?
  lastInboundAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  leads         Lead[]

  @@unique([organizationId, waId])
}

model Conversation {
  id                String             @id @default(cuid())
  organizationId    String
  contactId         String
  whatsappAccountId String
  status            ConversationStatus @default(OPEN)
  aiEnabled         Boolean            @default(true)
  assignedUserId    String?
  lastInboundAt     DateTime?
  lastMessageAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  whatsappAccount WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Restrict)
  assignedUser    User?           @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]
  leads           Lead[]

  @@index([organizationId, status, lastMessageAt])
  @@index([contactId])
  @@index([whatsappAccountId])
}

model Message {
  id             String            @id @default(cuid())
  organizationId String
  conversationId String
  direction      MessageDirection
  senderType     MessageSenderType
  type           MessageType       @default(TEXT)
  body           String?           @db.Text
  /// WhatsApp message ID (wamid). Unique per tenant for idempotent ingestion.
  waMessageId    String?
  status         MessageStatus
  errorCode      Int?
  errorMessage   String?
  metadata       Json?
  sentByUserId   String?
  /// Timestamp reported by WhatsApp.
  waTimestamp    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sentBy       User?        @relation("MessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  aiSuggestions AiSuggestion[]

  @@unique([organizationId, waMessageId])
  @@index([conversationId, createdAt])
}

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  contactId      String
  conversationId String?
  status         LeadStatus @default(NEW)
  title          String?
  source         String?
  notes          String?    @db.Text
  estimatedValue Decimal?   @db.Decimal(12, 2)
  /// ISO 4217 currency code.
  currency       String?    @db.VarChar(3)
  ownerUserId    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([contactId])
}

model KnowledgeDocument {
  id              String                  @id @default(cuid())
  organizationId  String
  title           String
  sourceType      KnowledgeSourceType     @default(MANUAL)
  sourceUri       String?
  content         String?                 @db.Text
  status          KnowledgeDocumentStatus @default(DRAFT)
  /// sha256 of content; detects re-uploads of identical documents.
  checksum        String?
  /// Original upload filename (txt, md, pdf), when uploaded.
  sourceFilename  String?
  /// Incremented whenever the content changes; chunks are rebuilt per version.
  version         Int                     @default(1)
  indexedAt       DateTime?
  /// Embedding model used for the current chunks (re-index when it changes).
  embeddingModel  String?
  /// Last indexing error (safe, non-sensitive summary).
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("DocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([organizationId, status])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  index          Int
  content        String   @db.Text
  tokenEstimate  Int
  /// pgvector embedding. Dimension is fixed by this column (768); changing it needs a migration
  /// and a re-index. GEMINI_EMBEDDING_DIMENSIONS is validated against it at startup.
  embedding      Unsupported("vector(768)")?
  embeddingModel String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([organizationId])
}

enum AiOperation {
  CHAT
  EMBEDDING
}

enum AiFeature {
  PLAYGROUND
  KNOWLEDGE_INDEXING
  AUTO_REPLY
  DRAFT_REPLY
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiSuggestionDecision {
  REPLY
  HANDOFF
}

/// One AI provider call, for usage limits, cost tracking and error monitoring. No prompt text.
model AiUsageEvent {
  id                  String      @id @default(cuid())
  organizationId      String
  userId              String?
  feature             AiFeature
  operation           AiOperation
  provider            String
  model               String
  inputTokens         Int         @default(0)
  outputTokens        Int         @default(0)
  thinkingTokens      Int         @default(0)
  embeddingDimensions Int?
  estimatedCostUsd    Decimal     @default(0) @db.Decimal(12, 6)
  latencyMs           Int         @default(0)
  success             Boolean
  /// Short code only (e.g. "http_429"); never message text that could echo input.
  errorCode           String?
  createdAt           DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

/// Budget held for an AI call in progress, so concurrent requests cannot overspend. Created under
/// a per-organization advisory lock and released when the call finishes (the AiUsageEvent then
/// records the actual cost). Unreleased reservations expire after 15 minutes.
model AiBudgetReservation {
  id             String    @id @default(cuid())
  organizationId String
  amountUsd      Decimal   @db.Decimal(12, 6)
  feature        AiFeature
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, releasedAt, createdAt])
}

/// An AI-generated answer for review. Suggestions are never sent to WhatsApp from Phase 3 code.
model AiSuggestion {
  id               String               @id @default(cuid())
  organizationId   String
  createdByUserId  String?
  /// "playground" (AI playground) or "conversation" (draft for an inbound WhatsApp message; never sent).
  source           String               @default("playground")
  conversationId   String?
  /// The inbound message a conversation draft answers. Unique: one draft per message, so a
  /// retried or duplicated job cannot store a second draft or attach it to another message.
  messageId        String?              @unique
  question         String               @db.Text
  decision         AiSuggestionDecision
  answer           String?              @db.Text
  handoffReason    String?
  /// A model draft that failed safety checks (reviewers only).
  withheldDraft    String?              @db.Text
  language         String?
  model            String?
  /// Retrieved knowledge: [{ chunkId, documentId, documentTitle, excerpt, score, similarity, cited }]
  sources          Json
  estimatedCostUsd Decimal              @default(0) @db.Decimal(12, 6)
  latencyMs        Int                  @default(0)
  status           AiSuggestionStatus   @default(PENDING)
  rating           Int?
  reviewNotes      String?              @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, conversationId, createdAt])
}

/// Durable job queue (see docs/ARCHITECTURE.md §4). Handlers must be idempotent.
model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  dedupeKey      String?   @unique
  organizationId String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?   @db.Text
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
