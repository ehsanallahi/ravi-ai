# Ravi AI environment variables.
# Copy to `.env` at the repository root and fill in YOUR OWN values. Never commit `.env`.
# Every value below is a placeholder; none of them is a working credential.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 15+ connection string. For local development, `pnpm db:local` starts a local
# cluster and prints the ravi_ai_dev URL to paste here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ravi_ai_dev?schema=public"
# Optional: integration tests use a throwaway database automatically. Set this only to point
# them at an existing LOCAL database whose name ends in "_test" (for example, in CI).
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ravi_ai_test"

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Signs sessions and encrypts TOTP secrets. Generate one with: openssl rand -base64 32
# Rotating it signs everyone out and invalidates enrolled authenticator apps.
BETTER_AUTH_SECRET=""
# Public base URL of the web app (https in production). Also the only trusted origin (CSRF).
BETTER_AUTH_URL="http://localhost:3000"
# Only "closed" is supported: no public sign-up; accounts come from the owner CLI or invitations.
REGISTRATION_MODE="closed"

# ─── Email ───────────────────────────────────────────────────────────────────
# "outbox" (local development: writes emails to .data/outbox, sends nothing) or "resend".
# Production refuses to start unless this is "resend".
EMAIL_PROVIDER="outbox"
# Resend API key and a sender on a domain you have verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Ravi AI <no-reply@your-verified-domain.example>"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Random string you choose; enter the same value in the Meta App Dashboard → WhatsApp → Configuration.
# Generate one with: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=""
# Meta App Dashboard → App settings → Basic → App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
# Graph API version used by the worker for outbound calls.
WHATSAPP_GRAPH_API_VERSION="v24.0"
# Only read by `pnpm --filter @ravi/db account:register`, which stores it ENCRYPTED in the database.
# Use a System User token from Meta Business Settings. Remove it from .env after registering.
WHATSAPP_ACCESS_TOKEN=""

# ─── Secrets encryption ──────────────────────────────────────────────────────
# 32 random bytes, base64-encoded. Encrypts stored access tokens (AES-256-GCM).
# Generate one with: openssl rand -base64 32
# Losing this key makes stored tokens unrecoverable (you would re-register them).
ENCRYPTION_KEY=""

# ─── AI ──────────────────────────────────────────────────────────────────────
# "disabled" (default) or "anthropic".
AI_PROVIDER="disabled"
AI_MODEL="claude-opus-5-5"
ANTHROPIC_API_KEY=""
# Global kill switch. AI replies also need the organization switch (Organization.aiAutoReplyEnabled)
# and the per-conversation switch to be on.
AI_AUTO_REPLY_ENABLED="false"

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS="1000"
WORKER_BATCH_SIZE="10"
WORKER_LOCK_TIMEOUT_MS="300000"

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL="info"
