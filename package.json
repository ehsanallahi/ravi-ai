{
  "name": "ravi-ai",
  "private": true,
  "description": "Ravi AI — WhatsApp AI customer-support and sales automation platform",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "db:generate": "pnpm --filter @ravi/db db:generate",
    "db:migrate:dev": "pnpm --filter @ravi/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @ravi/db db:migrate:deploy",
    "db:studio": "pnpm --filter @ravi/db db:studio",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:local": "pnpm --filter @ravi/testing db:local",
    "db:pgvector:setup": "pnpm --filter @ravi/testing db:pgvector:setup",
    "ai:check": "pnpm --filter @ravi/knowledge ai:check",
    "ai:eval": "pnpm --filter @ravi/knowledge ai:eval",
    "ai:eval:drafts": "pnpm --filter @ravi/knowledge ai:eval:drafts",
    "ai:kb-test": "pnpm --filter @ravi/web ai:kb-test",
    "whatsapp:check": "pnpm --filter @ravi/worker whatsapp:check",
    "whatsapp:simulate": "pnpm --filter @ravi/web whatsapp:simulate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
